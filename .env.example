# ================================================================
# Content Rewards Platform — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked  <replace_this>
#   3. NEVER commit your real .env file to version control.
#      Confirm .env is listed in your .gitignore before pushing.
# ================================================================


# ----------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------

# Port Express will listen on
PORT=3000

# 'development' | 'production' | 'test'
NODE_ENV=development

# API route prefix — all routes mount under /api/v1
API_VERSION=v1


# ----------------------------------------------------------------
# PostgreSQL DATABASE
# ----------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=content_rewards
DB_USER=postgres
DB_PASSWORD=<replace_this>

# Set to 'true' for any cloud-hosted database (Supabase, Railway, RDS, etc.)
DB_SSL=false

# Connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

# Milliseconds an idle client sits in the pool before being closed
DB_IDLE_TIMEOUT_MS=30000

# Milliseconds to wait for a connection before throwing an error
DB_CONNECTION_TIMEOUT_MS=5000

# Milliseconds before a runaway query is killed (10 000 = 10 seconds)
DB_STATEMENT_TIMEOUT_MS=10000


# ----------------------------------------------------------------
# JSON WEB TOKEN (JWT)
# ----------------------------------------------------------------

# Minimum 64 random characters in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace_this_with_64_plus_random_chars>

# Access token lifetime  (jsonwebtoken format: "7d", "24h", "3600")
JWT_EXPIRES_IN=7d

# A DIFFERENT secret used only for refresh tokens
JWT_REFRESH_SECRET=<replace_this_with_a_different_64_plus_random_chars>

JWT_REFRESH_EXPIRES_IN=30d


# ----------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------

# Global limiter — every endpoint
# Window: 900 000 ms = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints (login / register) — stricter
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# View-tracking endpoint — 24-hour window per IP × campaign
# Window: 86 400 000 ms = 24 hours
VIEW_RATE_LIMIT_WINDOW_MS=86400000
VIEW_RATE_LIMIT_MAX=50


# ----------------------------------------------------------------
# ANTI-FRAUD SETTINGS
# ----------------------------------------------------------------

# Max view attempts from one IP address per campaign per calendar day
MAX_VIEWS_PER_IP_PER_DAY=5

# Minimum seconds a creator must watch before a view counts as complete
MIN_WATCH_SECONDS=30

# Whether the client MUST supply a device fingerprint ('true' | 'false')
DEVICE_FINGERPRINT_REQUIRED=false


# ----------------------------------------------------------------
# REWARDS & FINANCIAL
# ----------------------------------------------------------------

# Fallback cost-per-view when a campaign does not override it (USD)
DEFAULT_COST_PER_VIEW=0.010000

# Minimum balance required before a creator may request a withdrawal (USD)
MIN_WITHDRAWAL_AMOUNT=5.00

# Platform fee deducted from every withdrawal (percentage — 2.5 = 2.5 %)
WITHDRAWAL_FEE_PERCENT=2.5


# ----------------------------------------------------------------
# MILESTONE BONUSES
# ----------------------------------------------------------------

# Comma-separated credited-view counts that trigger a one-time bonus
MILESTONE_THRESHOLDS=10,50,100,500,1000,5000,10000

# Bonus amount = campaign cost_per_view × this multiplier
MILESTONE_BONUS_MULTIPLIER=1.5


# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------

# Allowed frontend origin(s) — comma-separate multiple values
# Example: CORS_ORIGIN=https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:5173

CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS


# ----------------------------------------------------------------
# LOGGING  (Winston)
# ----------------------------------------------------------------

# error | warn | info | http | debug
LOG_LEVEL=debug

# Combined log file (directory is created automatically)
LOG_FILE=logs/app.log

# Error-only log file
LOG_ERROR_FILE=logs/error.log


# ----------------------------------------------------------------
# OPTIONAL — EMAIL
# Uncomment when you add email verification / notifications.
# ----------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=<replace_this>
# SMTP_FROM=Content Rewards <no-reply@example.com>
